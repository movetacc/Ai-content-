# Core content settings
OPENROUTER_API_KEY=
SCRIPT_MODEL=meta-llama/llama-3.1-8b-instruct:free
CONTENT_NICHE=AI side hustles and making money with AI
TTS_VOICE=en-US-GuyNeural
TTS_RATE=+8%
PEXELS_API_KEY=

# Publishing safety switches. Leave false until each integration is tested.
PUBLISH_YOUTUBE=false
PUBLISH_INSTAGRAM=false
PUBLISH_TIKTOK=false

# YouTube OAuth
# In GitHub Actions, save the full authorized-user JSON as YOUTUBE_TOKEN_JSON.
YOUTUBE_TOKEN_JSON=
YOUTUBE_CLIENT_SECRETS_PATH=
YOUTUBE_PRIVACY_STATUS=private

# Instagram / Meta Graph API. PUBLIC_VIDEO_URL must be a public direct MP4 URL.
IG_USER_ID=
IG_ACCESS_TOKEN=
PUBLIC_VIDEO_URL=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
